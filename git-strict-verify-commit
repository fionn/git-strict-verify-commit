#!/usr/bin/env bash

set -euo pipefail

function main {
    local -r commit="${1:-"HEAD"}"

    local allowed_signers_file
    allowed_signers_file="$(git config get gpg.ssh.allowedSignersFile)"
    allowed_signers_file="${allowed_signers_file/#~/${HOME}}"

    local committer
    committer="$(git log -1 "$commit" --format="%ce")"

    # Try to match the committer to an allowed signer principal. If this fails,
    # then we still carry on as usual, but after the standard signature
    # verification we exit with a failure and print the reason (e.g. "No
    # principal matched").
    local status=0
    local matched_principals
    matched_principals="$(ssh-keygen -Y match-principals -f "$allowed_signers_file" -I "$committer" 2>&1)" || status=$?

    git verify-commit "$commit"

    if [[ $status -ne 0 ]]; then
        echo "$matched_principals" >&2
        exit $status
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
